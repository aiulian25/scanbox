# Scan Box. Copy this to .env next to compose.yaml, then fill in the settings under "Required".
# Everything else is optional: uncomment what you want to change. Scanning, Paperless and dates
# are set in the page; the Paperless token and the page's password are files (see the README).

# --- Required ----------------------------------------------------------------------------------

# The one address of this machine the page is published on: its address on your network, or
# 127.0.0.1 when a TLS proxy runs on this machine. The page travels unencrypted on it.
SCANBOX_ADDRESS=192.168.10.20

# The group of the scanner's device file, so Scan Box opens the scanner and no other USB device.
# With the scanner plugged in: lsusb, then stat -c '%g %G' /dev/bus/usb/<bus>/<device>.
SCANNER_GID=7

# --- Optional ----------------------------------------------------------------------------------

# The time zone a new install starts in; after that it is chosen in Settings. UTC when unset.
# TZ=Europe/Paris

# Names with a dot in them that the page answers to, as behind a reverse proxy. Comma separated.
# SCANBOX_HOSTS=scan.example.org

# Your reverse proxy's address or range: its X-Forwarded-For and X-Forwarded-Proto are believed.
# SCANBOX_TRUSTED_PROXY=172.18.0.2

# Another image to run instead of the newest 0.x release, for example a pinned version.
# SCANBOX_IMAGE=ghcr.io/aiulian25/scanbox:0.1.0
